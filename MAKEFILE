# Borland MAKEFILE for 3CCFG project
# Targets:
#   make all
#   make 3ccfgcli
#   make 3chwmock
#   make seed
#   make clean

TASM = \TASM\BIN\TASM.EXE
TLINK = \TASM\BIN\TLINK.EXE
PKLITE = \PKLITE\PKLITE.EXE

TASMFLAGS = /jJUMPS /M5
OBJDIR = OBJ
BINDIR = BIN
PKLDIR = $(BINDIR)\PKLITE

all: 3ccfgcli 3chwmock seed

3ccfgcli: $(BINDIR)\3CCFGCLI.EXE

3chwmock: $(BINDIR)\3CHWMOCK.EXE

seed: $(BINDIR)\3CSEED.EXE

prep:
    # MAKEFILE deliberately does not clear BUILD.LOG - this is handled by build.sh
	@if not exist $(BINDIR)\NUL md $(BINDIR)
	@if not exist $(PKLDIR)\NUL md $(PKLDIR)
	@if not exist $(OBJDIR)\NUL md $(OBJDIR)

$(OBJDIR)\3CCFGCLI.OBJ: prep 3CCFGCLI.ASM 3C509DEF.INC 3CHWIF.ASM 3CMOCKIF.ASM
	$(TASM) $(TASMFLAGS) /dREALHW 3CCFGCLI.ASM,$(OBJDIR)\3CCFGCLI.OBJ

$(OBJDIR)\3CHWMOCK.OBJ: prep 3CCFGCLI.ASM 3C509DEF.INC 3CHWIF.ASM 3CMOCKIF.ASM
	$(TASM) $(TASMFLAGS) /dMOCKHW 3CCFGCLI.ASM,$(OBJDIR)\3CHWMOCK.OBJ

$(OBJDIR)\3CSEED.OBJ: prep 3CSEED.ASM 3C509DEF.INC
	$(TASM) $(TASMFLAGS) 3CSEED.ASM,$(OBJDIR)\3CSEED.OBJ

$(BINDIR)\3CCFGCLI.EXE: $(OBJDIR)\3CCFGCLI.OBJ
	$(TLINK) $(OBJDIR)\3CCFGCLI.OBJ,$(BINDIR)\3CCFGCLI.EXE
	@IF EXIST $(PKLITE) $(PKLITE) -o $(BINDIR)\3CCFGCLI.EXE $(PKLDIR)\3CCFGCLI.EXE

$(BINDIR)\3CHWMOCK.EXE: $(OBJDIR)\3CHWMOCK.OBJ
	$(TLINK) $(OBJDIR)\3CHWMOCK.OBJ,$(BINDIR)\3CHWMOCK.EXE

$(BINDIR)\3CSEED.EXE: $(OBJDIR)\3CSEED.OBJ
	$(TLINK) $(OBJDIR)\3CSEED.OBJ,$(BINDIR)\3CSEED.EXE

clean:
	@if exist $(OBJDIR)\3CCFGCLI.OBJ del $(OBJDIR)\3CCFGCLI.OBJ
	@if exist $(OBJDIR)\3CHWMOCK.OBJ del $(OBJDIR)\3CHWMOCK.OBJ
	@if exist $(OBJDIR)\3CSEED.OBJ del $(OBJDIR)\3CSEED.OBJ
	@if exist $(BINDIR)\3CCFGCLI.EXE del $(BINDIR)\3CCFGCLI.EXE
	@if exist $(BINDIR)\3CHWMOCK.EXE del $(BINDIR)\3CHWMOCK.EXE
	@if exist $(BINDIR)\3CSEED.EXE del $(BINDIR)\3CSEED.EXE
	@if exist $(BINDIR)\3CCFGCLI.MAP del $(BINDIR)\3CCFGCLI.MAP
	@if exist $(BINDIR)\3CHWMOCK.MAP del $(BINDIR)\3CHWMOCK.MAP
	@if exist $(BINDIR)\3CSEED.MAP del $(BINDIR)\3CSEED.MAP
	@if exist $(PKLDIR)\3CCFGCLI.EXE del $(PKLDIR)\3CCFGCLI.EXE
