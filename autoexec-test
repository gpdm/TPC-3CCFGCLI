[dosbox]
fastbioslogo     = true
startbanner      = false

# mandatory for DOSBox-X 2026.08.31
# to make relative paths work
working directory option = default
working directory default = .

[cpu]
# Intentional baseline: the normal smoke regression runs without an ISA PnP
# BIOS. test.sh derives a complementary PNP_BIOS_GATE environment from this
# same template with isapnpbios flipped to true (see test_pnp_bios in
# test.sh) to provide coverage for host dependent PnP behaviour.
isapnpbios = false
cycles=max limit 50000
turbo = true
turbo stop on key = false

[autoexec]
@ECHO OFF
SET PATH=%PATH%;C:\TASM\BIN;C:\PKLITE;C:\BIN
CLS
MOUNT C: . >NUL
C:
CALL TEST
EXIT
