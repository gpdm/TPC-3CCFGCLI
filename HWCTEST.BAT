@ECHO OFF
REM Default starter for 3CCFGCLI Hardware Compliance Read checks.
REM
REM It detects the installed EtherLink III model and dispatches
REM the matching HWCREAD.MK or HWCWRITE.MK target.
REM The complete test sequence stays in MAKE.
REM ERRORLEVEL handling deliberately stays inside this batch file.



REM Vars Init
SET ARTIFACT=
SET INITLOG=HWCINIT.LOG
SET DETECTED_NIC=UNKNOWN
SET TARGET=
SET MKFILE=
SET ROMTEST=

REM Sanitize 
IF EXIST %INITLOG% DEL %INITLOG% > NUL

REM FIXME should remove this
REM IF NOT EXIST ARTIFACT\NUL MD ARTIFACT
REM IF EXIST ARTIFACT\HWCTEST.LOG DEL ARTIFACT\HWCTEST.LOG > NUL
REM IF EXIST ARTIFACT\*.SET DEL ARTIFACT\*.SET > NUL


REM Perform initial hardware scan
3CCFGCLI.EXE LIST > %INITLOG%


REM CLI dispatch
REM I know, it's superugly, but this make arguments work case-insensitive.
REM Yes, an invalid argument will cause a LABEL NOT FOUND error.
REM But it's just a bloody batch for HWC regressions, so who cares?
GOTO O_%1

:O_
ECHO %0: Invalid command line argument.
GOTO HELP

:O_READ
SET MKFILE=HWCREAD.MK
SET LOGFILE=HWCREAD.LOG
SET TARGET=hwcr
SET HWC_TAG=hwcr
GOTO HWDETECT

:O_READROM
SET MKFILE=HWCREAD.MK
SET LOGFILE=HWCREAD.LOG
SET TARGET=hwcr
SET HWC_TAG=hwcr
SET ROMTEST=-DROM_TEST
GOTO HWDETECT

:O_READMULTI
SET MKFILE=HWCREAD.MK
SET LOGFILE=HWCREAD.LOG
SET TARGET=hwcrm
SET HWC_TAG=hwcrm
SET DETECTED_NIC=MULTI
GOTO RUN

:O_WRITE
SET MKFILE=HWCWRITE.MK
SET LOGFILE=HWCWRITE.LOG
SET TARGET=hwcw
SET HWC_TAG=hwcw
GOTO HWDETECT

:O_WRITEROM
SET MKFILE=HWCWRITE.MK
SET LOGFILE=HWCWRITE.LOG
SET TARGET=hwcw
SET HWC_TAG=hwcw
SET ROMTEST=-DROM_TEST
GOTO HWDETECT

:O_WRITEMULTI
SET MKFILE=HWCWRITE.MK
SET LOGFILE=HWCWRITE.LOG
SET TARGET=hwcwm
SET HWC_TAG=hwcwm
SET DETECTED_NIC=MULTI
GOTO RUN


:HELP
ECHO.
ECHO 3CCFGCLI Hardware Compliance Tests
ECHO.
ECHO Usage:
ECHO   %0 READ 
ECHO   %0 READROM
ECHO   %0 READMULTI    
ECHO   %0 WRITE
ECHO   %0 WRITEROM
ECHO   %0 WRITEMULTI
ECHO.
ECHO Commands:
ECHO   READ       3CCFGCLI observes while original 3C5X9CFG runs config commands.
ECHO   READROM    same as READ, but include Boot ROM tests
ECHO   READMULTI  same as READ, but for multiple NICs.
ECHO   WRITE      3CCFGCLI performs all configure commands and read-backs.
ECHO   WRITEROM   Same as WRITE, but include Boot ROM tests
ECHO   WRITEMULTI same as WRITE, but for multiple NICs.
ECHO.
GOTO OK


:HWDETECT
ECHO 3Com EtherLink III card detection running ... >> %INITLOG%
ECHO 3Com EtherLink III card detection running ...

FIND "3Com 3C509B-TPCoax:" %INITLOG% > NUL
IF NOT ERRORLEVEL 1 GOTO BTPC

FIND "3Com 3C509B-TPO:" %INITLOG% > NUL
IF NOT ERRORLEVEL 1 GOTO BTPO

FIND "3Com 3C509B-Combo:" %INITLOG% > NUL
IF NOT ERRORLEVEL 1 GOTO BCOMBO

FIND "3Com 3C509B-TP:" %INITLOG% > NUL
IF NOT ERRORLEVEL 1 GOTO BTP

FIND "3Com 3C509B:" %INITLOG% > NUL
IF NOT ERRORLEVEL 1 GOTO BCOAX

FIND "3Com 3C509-TP:" %INITLOG% > NUL
IF NOT ERRORLEVEL 1 GOTO TP

FIND "3Com 3C509-COAX:" %INITLOG% > NUL
IF NOT ERRORLEVEL 1 GOTO COAX

FIND "3Com 3C509-Combo:" %INITLOG% > NUL
IF NOT ERRORLEVEL 1 GOTO COMBO

FIND "3Com 3C509-TPO:" %INITLOG% > NUL
IF NOT ERRORLEVEL 1 GOTO TPO

FIND "3Com 3C509-TPCoax:" %INITLOG% > NUL
IF NOT ERRORLEVEL 1 GOTO TPC

ECHO Unsupported EtherLink III model. >> %INITLOG%
ECHO Unsupported EtherLink III model.
GOTO FAIL


:BTP
ECHO Detected 3C509B-TP.
SET DETECTED_NIC=BTP
GOTO RUN

:BCOAX
ECHO Detected 3C509B-COAX.
SET DETECTED_NIC=BCOAX
GOTO RUN

:BCOMBO
ECHO Detected 3C509B-Combo.
SET DETECTED_NIC=BCOMBO
GOTO RUN

:BTPO
ECHO Detected 3C509B-TPO.
SET DETECTED_NIC=BTPO
GOTO RUN

:BTPC
ECHO Detected 3C509B-TPCoax.
SET DETECTED_NIC=BTPC
GOTO RUN

:TP
ECHO Detected 3C509-TP.
SET DETECTED_NIC=TP
GOTO RUN

:COAX
ECHO Detected 3C509-COAX.
SET DETECTED_NIC=COAX
GOTO RUN

:COMBO
ECHO Detected 3C509-Combo.
SET DETECTED_NIC=COMBO
GOTO RUN

:TPO
ECHO Detected 3C509-TPO.
SET DETECTED_NIC=TPO
GOTO RUN

:TPC
ECHO Detected 3C509-TPCoax.
SET DETECTED_NIC=TPC
GOTO RUN


:RUN
REM As NIC is now detected, reset LOGFILE and ARTIFACT paths

REM Ensure output directories exist
IF NOT EXIST %DETECTED_NIC%\NUL MD %DETECTED_NIC%
IF NOT EXIST %ARTIFACT%\NUL MD %ARTIFACT%

REM Move INITLOG to the final LOGFILE and cleanup
COPY %INITLOG% %LOGFILE%
DEL %INITLOG%
SET INITLOG=

ECHO Running test target %TARGET% for detected NIC: %DETECTED_NIC% >> %LOGFILE%
ECHO Running test target %TARGET% for detected NIC: %DETECTED_NIC%

ECHO invoke: MAKE -f%MKFILE% -DCARD_%DETECTED_NIC% %ROMTEST% %TARGET% >> %LOGFILE%
ECHO invoke: MAKE -f%MKFILE% -DCARD_%DETECTED_NIC% %ROMTEST% %TARGET%

MAKE -f%MKFILE% -DCARD_%DETECTED_NIC% %ROMTEST% %TARGET%
IF ERRORLEVEL 1 GOTO FAIL

REM Create post-configurative config dump using original 3C5X9CFG binary
ECHO Taking post-configuration dump using 3C5X9CFG >> %LOGFILE%
ECHO Taking post-configuration dump using 3C5X9CFG
REM clear keyboard input buffer
stuffit 0

IF "%TARGET%" == "hwcr" GOTO EXPSINGLE
IF "%TARGET%" == "hwcw" GOTO EXPSINGLE
IF "%TARGET%" == "hwcrm" GOTO EXPMULTI
IF "%TARGET%" == "hwcwm" GOTO EXPMULTI

:EXPSINGLE
REM load macro sequence for 3C5X9CFG to export a config dump
stuffit +2 @62 +2 9 9 13 +2 9 13 +2 "%ARTIFACT%\%TARGET%.SET" +2 13 +2 27 27 13
3c5x9cfg
IF NOT EXIST %ARTIFACT%\%TARGET%.SET GOTO FAIL
GOTO OK

:EXPMULTI
REM load macro sequence for 3C5X9CFG to export first card's config
stuffit +2 13 +2 @62 +2 9 9 13 +2 9 13 +2 "%ARTIFACT%\%TARGET%_1.SET" +2 13 +2 27 27 13
3c5x9cfg
REM load macro sequence for 3C5X9CFG to export second card's config
stuffit +2 @80 13 +2 @62 +2 9 9 13 +2 9 13 +2 "%ARTIFACT%\%TARGET%_2.SET" +2 13 +2 27 27 13
3c5x9cfg
IF NOT EXIST %ARTIFACT%\%TARGET%_1.SET GOTO FAIL
IF NOT EXIST %ARTIFACT%\%TARGET%_2.SET GOTO FAIL
GOTO OK

:FAIL
REM Deliberately return a nonzero DOS ERRORLEVEL.
ECHO Hardware Compliance Test FAILED. See %LOGFILE% for more details. >> %LOGFILE%
ECHO Hardware Compliance Test FAILED. See %LOGFILE% for more details.
FIND "HWC-FAILURE-SENTINEL" %LOGFILE% > NUL
GOTO END

:OK
ECHO Hardware Compliance Test PASSED. >> %LOGFILE%
ECHO Hardware Compliance Test PASSED.
REM Reset ERRORLEVEL to zero using text known to exist in a successful LIST.
FIND "3Com " %LOGFILE% > NUL

:END
SET HWC_TAG=
